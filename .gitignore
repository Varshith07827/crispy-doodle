# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Local SQLite databases (the app writes to %LOCALAPPDATA%, but ignore any strays)
*.db
*.db-wal
*.db-shm

# OS / editor
.DS_Store
*.swp
build/
dist/
*.spec.bak

# Packaged snapshots of the source — build output, not source.
winspark-share.zip

# Per-machine Claude Code settings (permissions allowlist); the shared
# .claude/settings.json, if any, is still tracked.
.claude/settings.local.json

# Prototype runtime output. `prototypes/neonize/` holds no source — only what a
# run produced: downloaded media, its sidecar JSON, and session.sqlite3, which
# is the linked-device credential store for a real WhatsApp account. None of it
# belongs in a repository.
prototypes/*/media/
prototypes/*/session.sqlite3
prototypes/*/*.sqlite3
